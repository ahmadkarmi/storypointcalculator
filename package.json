{
  "name": "spcalculator",
  "version": "2.0.0",
  "description": "Agile story point estimator PWA. Rate eight factors, get a Fibonacci estimate and T-shirt size.",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "http-server -c-1 -p 8080",
    "test": "jest",
    "test:watch": "jest --watchAll --verbose",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/styleMock.js"
    }
  },
  "keywords": [
    "agile",
    "scrum",
    "story-points",
    "estimation",
    "fibonacci",
    "pwa"
  ],
  "author": "Ahmad Al-Karmi",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.27.3",
    "@babel/preset-env": "^7.27.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "jsdom": "^26.1.0"
  }
}
